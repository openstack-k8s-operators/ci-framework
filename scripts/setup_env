## Shell Opts ----------------------------------------------------------------
set -o pipefail
set -xeuo

## Vars ----------------------------------------------------------------------
export PROJECT_DIR="$(dirname $(dirname $(readlink -f ${BASH_SOURCE[0]})))"
# NOTE(cloudnull): Disable ansible compat check, caters to the case where
#                  system ansible may be installed.
export ANSIBLE_SKIP_CONFLICT_CHECK=1

USE_VENV=${USE_VENV:-'yes'}

## Main ----------------------------------------------------------------------
# Source distribution information
source /etc/os-release || source /usr/lib/os-release
RHT_PKG_MGR=$(command -v dnf)
# Keep the system interpreter unchanged; Ansible's controller uses 3.12.
PYTHON_EXEC="${CIFMW_PYTHON_EXEC:-python3.12}"

if [[ -z "${CIFMW_PYTHON_EXEC:-}" ]]; then
    sudo "${RHT_PKG_MGR}" install -y python3.12 python3.12-pip
fi

echo "Using Python interpreter: ${PYTHON_EXEC}"
"${PYTHON_EXEC}" --version

# Install the requirements we need to run local tests
command -v gcc || sudo dnf -y install gcc

PIP_INSTALL_ARGUMENTS="-U -r ${PROJECT_DIR}/common-requirements.txt"
case ${USE_VENV} in
    y|yes|true)
        PIP=("${HOME}/test-python/bin/pip3")
        USE_VENV='yes'
        echo
        echo ### USING VIRTUALENV
        echo
        ;;
    *)
        PIP=("${PYTHON_EXEC}" -m pip)
        USE_VENV='no'
        # Gate jobs don't have /root/.local/bin in PATH, so install globally
        if [ "$(whoami)" != "root" ]; then
            PIP_INSTALL_ARGUMENTS="--user ${PIP_INSTALL_ARGUMENTS}"
        fi
        echo
        echo ### NO VENV - may break your system!
        echo
        ;;
esac

# Kill all sudo in the current shell
sudo -k

# Ensure the required ci file is presnet
mkdir -p ${HOME}/ci/yum.repos.d
cp /etc/ci/mirror_info.sh ${HOME}/ci || touch ${HOME}/ci/mirror_info.sh
cp -r /opt/yum.repos.d/* ${HOME}/ci/yum.repos.d || cp -r /etc/yum.repos.d/* ${HOME}/ci/yum.repos.d


case ${USE_VENV} in
    y|yes|true)
        # Create a virtual env
        "${PYTHON_EXEC}" -m venv --upgrade-deps "${HOME}/test-python"
        if [[ -d "${HOME}/.cache/pip/wheels" ]]; then
            rm -rf "${HOME}/.cache/pip/wheels"
        fi
        ;;
esac

# Run bindep
"${PIP[@]}" install pip setuptools bindep --upgrade
"${PROJECT_DIR}/scripts/bindep-install"

"${PYTHON_EXEC}" -m pip install ${PIP_INSTALL_ARGUMENTS}

# The isolated test venv also needs the collection's runtime dependencies.
if [[ ${USE_VENV} == yes ]]; then
    "${PIP[@]}" install -U -r "${PROJECT_DIR}/common-requirements.txt"
fi

# Local modules still use the system interpreter for RPM-provided bindings.
# Keep their Kubernetes dependencies consistent with the controller pins.
# Explicit oauthlib installation avoids the incompatible cloud-image RPM.
if [[ $(/usr/bin/python3 -c 'import sys; print(sys.version_info[:2])') != \
      $("${PYTHON_EXEC}" -c 'import sys; print(sys.version_info[:2])') ]]; then
    SYSTEM_PIP_ARGS=(-U -c "${PROJECT_DIR}/common-requirements.txt")
    # Root image builds need global packages; CI users only need their user site.
    if [[ $(id -u) -ne 0 ]]; then
        SYSTEM_PIP_ARGS+=(--user)
    fi
    /usr/bin/python3 -m pip install "${SYSTEM_PIP_ARGS[@]}" kubernetes kubernetes-validate oauthlib
    /usr/bin/python3 -c 'import kubernetes, kubernetes_validate; from requests_oauthlib import OAuth2Session'
fi

# Display list of installed packages with versions (debugging failures)
"${PYTHON_EXEC}" -m pip freeze
"${PIP[@]}" freeze
