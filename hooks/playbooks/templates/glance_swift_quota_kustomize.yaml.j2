apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources: []
namespace: {{ namespace }}
patches:
- target:
    kind: OpenStackControlPlane
    name: .*
  patch: |-
    - op: replace
      path: /metadata/name
      value: openstack
- target:
    kind: OpenStackControlPlane
    name: .*
  patch: |-
    - op: remove
      path: /metadata/namespace
- path: {{ glance_operator_path + '/config/samples/quotas/glance_quota.yaml' }}
# a bit more resources than the samples one are needed
- target:
    kind: OpenStackControlPlane
    name: .*
  patch: |-
    - op: replace
      path: /spec/glance/template/quotas/imageCountTotal
      value: 1000
    - op: replace
      path: /spec/glance/template/quotas/imageCountUpload
      value: 1000
