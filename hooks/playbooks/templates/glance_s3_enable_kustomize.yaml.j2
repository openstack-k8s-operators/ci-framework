apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources: []
namespace: {{ namespace }}
patches:
- target:
    kind: OpenStackControlPlane
    name: .*
  patch: |-
    - op: replace
      path: /metadata/name
      value: openstack
- target:
    kind: OpenStackControlPlane
    name: .*
  patch: |-
    - op: remove
      path: /metadata/namespace
- path: {{ glance_operator_path + '/config/samples/backends/s3/s3.yaml' }}
