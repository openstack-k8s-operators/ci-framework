---
apiVersion: v1
kind: Secret
metadata:
  name: s3glance
stringData:
  s3secret.conf : |
    [default_backend]
    s3_store_host = {{ _glance_s3_store_endpoint }}
    s3_store_access_key = {{ _glance_s3_store_access_key }}
    s3_store_secret_key = {{ _glance_s3_store_secret_key }}
    s3_store_bucket = {{ _glance_s3_store_bucket }}
