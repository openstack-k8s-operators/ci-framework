apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
namespace: {{ namespace }}
patches:
- target:
    kind: OpenStackControlPlane
    name: .*
  patch: |-
    - op: add
      path: /spec/barbican/template/globalDefaultSecretStore
      value: {{ _bss_global_default_type }}
    - op: add
      path: /spec/barbican/template/enabledSecretStores
      value:
{% for t in _bss_enabled_unique %}
        - {{ t }}
{% endfor %}
{% if _bss_kmip_spec | length > 0 %}
    - op: add
      path: /spec/barbican/template/kmip
      value:
        clientDataSecret: {{ _bss_kmip_spec.clientDataSecret }}
        clientDataPath: {{ _bss_kmip_spec.clientDataPath }}
    # THROWAWAY: overlay Client.key at 0400 until barbican-operator
    # mounts clientData with DefaultMode 0400 (draft PR; OPENSTACK_IMG
    # index:latest still ships 0440). SubPath overlays the directory mount.
    # Remove when quay …/openstack-operator-index:latest includes the fix.
    - op: add
      path: /spec/barbican/template/extraMounts
      value:
        - name: kmip-client-key-mode-0400
          extraVol:
            - extraVolType: KmipClientKeyMode
              propagation:
                - BarbicanAPI
                - BarbicanWorker
              volumes:
                - name: kmip-client-key-0400
                  secret:
                    secretName: {{ _bss_kmip_spec.clientDataSecret }}
                    defaultMode: 256
                    items:
                      - key: Client.key
                        path: Client.key
                        mode: 256
              mounts:
                - name: kmip-client-key-0400
                  mountPath: {{ _bss_kmip_spec.clientDataPath }}/Client.key
                  subPath: Client.key
                  readOnly: true
{% endif %}
{% if _bss_pkcs11_spec | length > 0 %}
    - op: add
      path: /spec/barbican/template/pkcs11
      value:
        loginSecret: {{ _bss_pkcs11_spec.loginSecret }}
        clientDataSecret: {{ _bss_pkcs11_spec.clientDataSecret }}
        clientDataPath: {{ _bss_pkcs11_spec.clientDataPath }}
{% endif %}
{% if _bss_custom_service_config | length > 0 %}
    - op: add
      path: /spec/barbican/template/customServiceConfig
      value: |
{{ _bss_custom_service_config | indent(8, first=True) }}
{% endif %}
