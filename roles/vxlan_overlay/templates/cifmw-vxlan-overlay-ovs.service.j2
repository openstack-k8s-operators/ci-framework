# Managed by Ansible (cifmw_vxlan_overlay).
# Pulled in by openvswitch.service (WantedBy) and restarted with it
# (PartOf). Turns {{ cifmw_vxlan_overlay_bridge }} into an OVS bridge with a patch port for
# os-net-config's br-ex. The symlink in openvswitch.service.wants is created
# before Open vSwitch is installed, so EDPM starting OVS triggers it.
[Unit]
Description=CI VXLAN overlay: OVS transport bridge ({{ cifmw_vxlan_overlay_bridge }})
After=openvswitch.service {{ cifmw_vxlan_overlay_unit }}.service
PartOf=openvswitch.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash {{ cifmw_vxlan_overlay_script }} ovs

[Install]
WantedBy=openvswitch.service
