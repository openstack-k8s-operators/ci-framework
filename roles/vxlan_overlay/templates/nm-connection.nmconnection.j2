{# Based on components-integration-config playbooks/crc/templates/bootstrap-ci-network-nm-connection.nmconnection.j2 #}
[connection]
id={{ iface_info.connection }}
uuid={{ (zuul.build | default('cifmw-vxlan-overlay') ~ inventory_hostname ~ iface_info.connection) | to_uuid }}
type=ethernet
autoconnect=true
interface-name={{ iface_info.iface }}
zone={{ cifmw_vxlan_overlay_firewall_zone }}

[ethernet]
mac-address={{ iface_info.mac | trim | lower }}
mtu={{ iface_info.mtu }}

[ipv4]
method=manual
{% for addr in [iface_info.ip] + (extra_addresses | default([])) %}
address{{ loop.index }}={{ addr }}
{% endfor %}
never-default=true
{% if iface_info.gw is defined and iface_info.gw != '' and not (extra_addresses | default([])) %}
gateway={{ iface_info.gw }}
{% endif %}
{% if iface_info.dns is defined and iface_info.dns | length > 0 %}
dns={{ (iface_info.dns | join(";")) + ";" }}
{% endif %}

[ipv6]
addr-gen-mode=stable-privacy
method=disabled

[proxy]
