# Managed by Ansible (cifmw_vxlan_overlay).
# Runs before NetworkManager so the overlay interface exists when its
# profile autoconnects, and before Open vSwitch re-attaches the leaf devices
# where the transport bridge is an OVS bridge ({{ cifmw_vxlan_overlay_ovs_unit }}.service).
[Unit]
Description=CI VXLAN overlay ({{ cifmw_vxlan_overlay_iface }})
Before=network-pre.target NetworkManager.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash {{ cifmw_vxlan_overlay_script }} start
ExecStop=/bin/bash {{ cifmw_vxlan_overlay_script }} stop

[Install]
WantedBy=multi-user.target
