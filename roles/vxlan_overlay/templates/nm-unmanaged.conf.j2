# Managed by Ansible (cifmw_vxlan_overlay).
# The overlay plumbing is owned by {{ cifmw_vxlan_overlay_unit }}.service. Only
# {{ cifmw_vxlan_overlay_iface }} (and its VLANs) are managed by NetworkManager.
# '+=' appends to lists set by other snippets (for example on OCP nodes).
[keyfile]
unmanaged-devices+=interface-name:{{ cifmw_vxlan_overlay_bridge }};interface-name:{{ cifmw_vxlan_overlay_peer_iface }};interface-name:{{ cifmw_vxlan_overlay_tunnel_prefix }}*;interface-name:{{ _cifmw_vxlan_overlay_patch_port }}
