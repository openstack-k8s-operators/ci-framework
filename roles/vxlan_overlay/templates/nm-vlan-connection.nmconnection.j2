{# Based on components-integration-config playbooks/crc/templates/bootstrap-ci-network-vlan-nm-connection.nmconnection.j2 #}
[connection]
id={{ iface_info.connection }}
uuid={{ (zuul.build | default('cifmw-vxlan-overlay') ~ inventory_hostname ~ iface_info.connection) | to_uuid }}
type=vlan
autoconnect=true
interface-name={{ iface_info.parent_iface }}.{{ iface_info.vlan }}
zone={{ cifmw_vxlan_overlay_firewall_zone }}

[ethernet]
cloned-mac-address={{ iface_info.mac | trim | lower }}
mtu={{ iface_info.mtu }}

[vlan]
flags=1
id={{ iface_info.vlan }}
parent={{ iface_info.parent_iface }}

[ipv4]
method=manual
address1={{ iface_info.ip }}
{% if iface_info.gw is defined and iface_info.gw != '' %}
gateway={{ iface_info.gw }}
{% endif %}
{% if iface_info.dns is defined and iface_info.dns | length > 0 %}
dns={{ (iface_info.dns | join(";")) + ";" }}
{% endif %}

[ipv6]
addr-gen-mode=stable-privacy
method=disabled

[proxy]
