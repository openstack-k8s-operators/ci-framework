#!/bin/bash
set -eu

case "$*" in
    'pull --tls-verify=false registry.test:5000/openstack/openstack-edpm-bootc:test-s2i')
        touch "$(dirname "$0")/../prebuilt-pull-passed"
        ;;
    'tag registry.test:5000/openstack/openstack-edpm-bootc:test-s2i localhost/edpm-bootc:test-s2i')
        test -f "$(dirname "$0")/../prebuilt-pull-passed"
        touch "$(dirname "$0")/../prebuilt-tag-passed"
        ;;
    *) exit 1 ;;
esac
