# Managed by Ansible (multi_node_vxlan).
# The overlay plumbing is owned by {{ cifmw_multi_node_vxlan_unit }}.service. Only
# {{ cifmw_multi_node_vxlan_iface }} (and its VLANs) are managed by NetworkManager.
# '+=' appends to lists set by other snippets (for example on OCP nodes).
{% set interfaces = [
    cifmw_multi_node_vxlan_bridge,
    cifmw_multi_node_vxlan_peer_iface,
    cifmw_multi_node_vxlan_tunnel_prefix ~ '*',
] + cifmw_multi_node_vxlan_unmanaged_interfaces %}
[keyfile]
unmanaged-devices+={{ interfaces | map('regex_replace', '^', 'interface-name:') | join(';') }}
