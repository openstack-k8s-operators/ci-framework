# Managed by Ansible (multi_node_vxlan).
# Runs before NetworkManager so the overlay interface exists when its
# profile autoconnects.
[Unit]
Description=CI VXLAN overlay ({{ cifmw_multi_node_vxlan_iface }})
Before=network-pre.target NetworkManager.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash {{ cifmw_multi_node_vxlan_script }} start
ExecStop=/bin/bash {{ cifmw_multi_node_vxlan_script }} stop

[Install]
WantedBy=multi-user.target
